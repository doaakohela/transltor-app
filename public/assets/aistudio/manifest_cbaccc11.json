{
  "manifest_version": 3,
  "name": "Translate words, texts & convert to MP3",
  "version": "1.1.0",
  "description": "Free translation in 100+ languages, 2x/1x audio, 10k words import, and true MP3 download.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tts",
    "downloads"
  ],
  "host_permissions": [
    "https://translate.google.com/*",
    "https://translate.googleapis.com/*",
    "*://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Translate words, texts & convert to MP3",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}