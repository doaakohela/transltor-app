{
  "manifest_version": 3,
  "name": "Translate words, texts & convert to MP3",
  "version": "1.1.2",
  "description": "Translate text across 100+ languages, listen to 2x/1x pronunciation, study vocabulary, and download genuine MP3 audio.",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Translate words, texts & convert to MP3",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
